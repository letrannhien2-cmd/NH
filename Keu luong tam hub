local function applyEspToPlayer(p)
    if p == player then return end
    local function setupChar(char)
        if not char then return end
        
        local highlight = char:FindFirstChild("KLT_ESP_Highlight")
        if not highlight then
            highlight = Instance.new("Highlight")
            highlight.Name = "KLT_ESP_Highlight"
            highlight.FillColor = Color3.fromRGB(255, 0, 80)
            highlight.FillTransparency = 0.5
            highlight.OutlineColor = Color3.fromRGB(0, 255, 200)
            highlight.OutlineTransparency = 0
            highlight.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
            highlight.Parent = char
        end
        highlight.Enabled = state.esp

        local head = char:WaitForChild("Head", 5)
        if head then
