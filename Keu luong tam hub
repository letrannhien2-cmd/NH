local flyCamToggleBtn = createToggleBtn("📷 Flycam (Camera bay)", visualContent, function(val)
    state.flyCam = val
    if val then
        if state.fighterJet and disableFighterJet then disableFighterJet() end -- Tắt Fighter Jet nếu đang bật
        
        quickTpBtn.Visible = true
        camCFrame = camera.CFrame
        local rx, ry, rz = camCFrame:ToOrientation()
        rotX, rotY = rx, ry
        camera.CameraType = Enum.CameraType.Scriptable
        if isMobile then mobileControls.Visible = true end

        flyCamInputConnection = UserInputService.InputBegan:Connect(function(input, gpe)
            if input.UserInputType == Enum.UserInputType.MouseButton2 then
                isRightMouseDown = true
                lastTouchPos = UserInputService:GetMouseLocation()
            elseif input.UserInputType == Enum.UserInputType.Touch then
                lastTouchPos = input.Position
            end
        end)
        
        UserInputService.InputEnded:Connect(function(input)
            if input.UserInputType == Enum.UserInputType.MouseButton2 then isRightMouseDown = false end
        end)
        
        UserInputService.TouchMoved:Connect(function(touch, gpe)
            if gpe then return end
            local delta = touch.Position - lastTouchPos
            lastTouchPos = touch.Position
            rotY = rotY - math.rad(delta.X * 0.35)
            rotX = math.clamp(rotX - math.rad(delta.Y * 0.35), math.rad(-89), math.rad(89))
        end)
        
        flyCamConnection = RunService.RenderStepped:Connect(function()
            if isRightMouseDown then
                local currentPos = UserInputService:GetMouseLocation()
                local delta = currentPos - lastTouchPos
                lastTouchPos = currentPos
                rotY = rotY - math.rad(delta.X * 0.3)
                rotX = math.clamp(rotX - math.rad(delta.Y * 0.3), math.rad(-89), math.rad(89))
            end
            
            local rotMatrix = CFrame.Angles(0, rotY, 0) * CFrame.Angles(rotX, 0, 0)
            local moveVector = Vector3.new()
            
            if UserInputService:IsKeyDown(Enum.KeyCode.W) or moveState.forward then moveVector = moveVector + rotMatrix.LookVector end
            if UserInputService:IsKeyDown(Enum.KeyCode.S) or moveState.backward then moveVector = moveVector - rotMatrix.LookVector end
            if UserInputService:IsKeyDown(Enum.KeyCode.A) or moveState.left then moveVector = moveVector - rotMatrix.RightVector end
            if UserInputService:IsKeyDown(Enum.KeyCode.D) or moveState.right then moveVector = moveVector + rotMatrix.RightVector end
            if UserInputService:IsKeyDown(Enum.KeyCode.E) or moveState.up then moveVector = moveVector + Vector3.new(0, 1, 0) end
            if UserInputService:IsKeyDown(Enum.KeyCode.Q) or moveState.down then moveVector = moveVector - Vector3.new(0, 1, 0) end

            camCFrame = CFrame.new(camCFrame.Position + moveVector * flyCamSpeed) * rotMatrix
            camera.CFrame = camCFrame
        end)
    else
        quickTpBtn.Visible = false
        mobileControls.Visible = false
        for k in pairs(moveState) do moveState[k] = false end
        if flyCamConnection then flyCamConnection:Disconnect() end
        if flyCamInputConnection then flyCamInputConnection:Disconnect() end
        local char = player.Character
        if char and char:FindFirstChild("Humanoid") then
            camera.CameraType = Enum.CameraType.Custom
            camera.CameraSubject = char.Humanoid
        end
    end
end)

