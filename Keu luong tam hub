-- PHYSICS & LOOP LOGIC
RunService.Stepped:Connect(function()
    local char = player.Character
    if char then
        -- NOCLIP (ĐI XUYÊN TƯỜNG)
        if state.noclip then
            for _, part in ipairs(char:GetDescendants()) do
                if part:IsA("BasePart") and part.CanCollide then
                    part.CanCollide = false
                end
            end
        end

        local hum = char:FindFirstChild("Humanoid")
        if hum then
            if state.speedBoost and hum.WalkSpeed ~= speedValue then hum.WalkSpeed = speedValue end
            if state.jumpBoost then
                hum.UseJumpPower = true
                if hum.JumpPower ~= jumpValue then hum.JumpPower = jumpValue end
            end
        end

        -- ANTI-GRAB LOGIC
        if state.antiGrab then
            if hum then
                if hum.Sit then hum.Sit = false end
                if hum.PlatformStand then hum.PlatformStand = false end
            end

            for _, obj in ipairs(char:GetDescendants()) do
                if obj:IsA("JointInstance") or obj:IsA("Weld") or obj:IsA("WeldConstraint") or obj:IsA("RopeConstraint") or obj:IsA("Motor6D") or obj:IsA("SpringConstraint") then
                    if obj.Part0 and obj.Part1 then
                        local p0Char = obj.Part0:FindFirstAncestorOfClass("Model")
                        local p1Char = obj.Part1:FindFirstAncestorOfClass("Model")
                        if (p0Char and p0Char ~= char) or (p1Char and p1Char ~= char) then
                            obj:Destroy()
                        end
                    end
                elseif obj:IsA("BodyMover") or obj:IsA("AlignPosition") or obj:IsA("LinearVelocity") or obj:IsA("VectorForce") then
                    if obj.Name ~= "AirWalkForce" then 
                        obj:Destroy() 
                    end
                end
            end
        end
    end
end)

RunService.Heartbeat:Connect(function()
    local char = player.Character
    if not char or not char:FindFirstChild("HumanoidRootPart") then return end
    local myHrp = char.HumanoidRootPart

    if state.chongBiVang then
        if myHrp.AssemblyLinearVelocity.Magnitude > 200 then
            myHrp.AssemblyLinearVelocity = Vector3.new(0, myHrp.AssemblyLinearVelocity.Y, 0)
        end
        if myHrp.AssemblyAngularVelocity.Magnitude > 100 then
            myHrp.AssemblyAngularVelocity = Vector3.new(0, 0, 0)
        end
    end

    if state.skyLaunch then
        for _, targetPlayer in ipairs(Players:GetPlayers()) do
            if targetPlayer ~= player and targetPlayer.Character then
                local tChar = targetPlayer.Character
                local tHrp = tChar:FindFirstChild("HumanoidRootPart") or tChar.PrimaryPart
                if tHrp and (tHrp.Position - myHrp.Position).Magnitude <= 15 then
                    tHrp.AssemblyLinearVelocity = Vector3.new(0, 3000, 0)
                    tHrp.AssemblyAngularVelocity = Vector3.new(500, 500, 500)
                end
            end
        end
    end
end)

task.spawn(function()
    while true do
        task.wait(0.05)
        local char = player.Character
        if char and char:FindFirstChild("HumanoidRootPart") then
            local myHrp = char.HumanoidRootPart

            if state.airWalk then
                if not airPlatform or not airPlatform.Parent then
                    airPlatform = Instance.new("Part")
                    airPlatform.Size = Vector3.new(6, 1, 6)
                    airPlatform.Anchored = true
                    airPlatform.CanCollide = true
                    airPlatform.CanQuery = false
                    airPlatform.Material = Enum.Material.Neon
                    airPlatform.Color = Color3.fromRGB(0, 255, 200)
                    airPlatform.Transparency = 0.5
                    airPlatform.Parent = Workspace
                end
                airPlatform.CFrame = CFrame.new(myHrp.Position.X, myHrp.Position.Y - 3.5, myHrp.Position.Z)
            elseif airPlatform then
                airPlatform:Destroy()
                airPlatform = nil
            end

            if state.autoGrab then
                for _, target in ipairs(Players:GetPlayers()) do
                    if target ~= player and target.Character and target.Character:FindFirstChild("HumanoidRootPart") then
                        local tHrp = target.Character.HumanoidRootPart
                        if (tHrp.Position - myHrp.Position).Magnitude < 15 then
                            tHrp.CFrame = myHrp.CFrame * CFrame.new(0, 0, -3)
                        end
                    end
                end
            end
        end
    end
end)

